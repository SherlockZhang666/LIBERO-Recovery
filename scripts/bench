#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export UV_CACHE_DIR="$ROOT/cache/uv" UV_PYTHON_INSTALL_DIR="$ROOT/.tools/python" HF_HOME="$ROOT/cache/huggingface" HF_DATASETS_CACHE="$ROOT/cache/huggingface/datasets" MODELSCOPE_CACHE="$ROOT/cache/modelscope" OPENPI_DATA_HOME="$ROOT/cache/openpi" LIBERO_CONFIG_PATH="$ROOT/cache/libero" MPLCONFIGDIR="$ROOT/cache/matplotlib" NUMBA_CACHE_DIR="$ROOT/cache/numba" JAX_COMPILATION_CACHE_DIR="$ROOT/cache/jax" JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=1 XDG_CACHE_HOME="$ROOT/cache/xdg"
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false MUJOCO_GL=egl PYOPENGL_PLATFORM=egl XLA_PYTHON_CLIENT_PREALLOCATE=false
export PYTHONPATH="$ROOT/LIBERO:$ROOT/vendor/openpi/packages/openpi-client/src"
cmd="${1:-status}";shift || true
case "$cmd" in
 status) exec python3 scripts/status.py "$@";;
 list) exec python3 scripts/list_scenes.py "$@";;
 doctor) exec 9>"$ROOT/../.coordination/gpu.lock"; flock 9; exec .venv-sim/bin/python scripts/doctor.py "$@";;
 replay-check) exec 9>"$ROOT/../.coordination/gpu.lock"; flock 9; exec .venv-sim/bin/python scripts/validate_scene.py "$@";;
 setup) exec bash scripts/setup.sh "$@";;
 policy|recovery|acceptance)
   mkdir -p logs runs
   exec 9>"$ROOT/../.coordination/gpu.lock"
   flock 9
   stamp="$(date -u +%Y%m%dT%H%M%SZ)_${cmd}"
   printf '%s GPU reservation acquired: %s\n' "$stamp" "$ROOT"
   port=18061
   server_pid=''
   monitor_pid=''
   cleanup(){ if [[ -n "$server_pid" ]];then kill "$server_pid" 2>/dev/null || true;wait "$server_pid" 2>/dev/null || true;fi;if [[ -n "$monitor_pid" ]];then kill "$monitor_pid" 2>/dev/null || true;wait "$monitor_pid" 2>/dev/null || true;fi;python3 scripts/status.py --write >/dev/null;printf "GPU reservation released: %s\n" "$ROOT"; }
   trap cleanup EXIT INT TERM
   BENCH_RUN_ID="$stamp" PYTHONPATH="$ROOT/vendor/openpi/src:$ROOT/vendor/openpi/packages/openpi-client/src" vendor/openpi/.venv/bin/python scripts/serve.py > "logs/server_${stamp}.log" 2>&1 &
   server_pid=$!
   python3 scripts/monitor_policy.py "$server_pid" > "logs/memory-monitor_${stamp}.log" 2>&1 &
   monitor_pid=$!
   ready=0
   for ((i=0;i<360;i++));do
     if ! kill -0 "$server_pid" 2>/dev/null;then tail -80 "logs/server_${stamp}.log";exit 1;fi
     if curl --silent --fail --max-time 1 http://127.0.0.1:18061/healthz >/dev/null 2>&1;then ready=1;break;fi
     sleep 2
   done
   if [[ "$ready" != 1 ]];then echo 'Policy startup timed out';exit 1;fi
   if [[ "$cmd" == acceptance ]];then
     .venv-sim/bin/python scripts/rollout.py --mode policy --run-id "${stamp}_policy" --port "$port" "$@" 2>&1 | tee "logs/eval_${stamp}_policy.log"
     .venv-sim/bin/python scripts/rollout.py --mode recovery --run-id "${stamp}_recovery" --port "$port" --scenes 2 "$@" 2>&1 | tee "logs/eval_${stamp}_recovery.log"
   else
     .venv-sim/bin/python scripts/rollout.py --mode "$cmd" --run-id "$stamp" --port "$port" "$@" 2>&1 | tee "logs/eval_${stamp}.log"
   fi
   ;;
 *) echo 'Usage: scripts/bench {setup|doctor|replay-check|list|policy|recovery|acceptance|status}';exit 2;;
esac
